/* contact.wxss */
.container {
  background-color: #f8f8f8;
  padding-bottom: 100rpx;
}

/* 搜索栏样式 */
.search-bar {
  padding: 20rpx;
  background-color: #fff;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  position: sticky;
  top: 0;
  z-index: 100;
}

.search-input {
  display: flex;
  align-items: center;
  background-color: #f5f5f5;
  border-radius: 30rpx;
  padding: 0 20rpx;
  height: 70rpx;
}

.search-input .icon-search {
  color: #999;
  margin-right: 10rpx;
}

.search-input input {
  flex: 1;
  height: 100%;
  font-size: 28rpx;
  color: #333;
}

.search-input .icon-clear {
  color: #999;
  padding: 10rpx;
}

/* 添加联系人按钮 */
.add-contact-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 20rpx;
  padding: 25rpx;
  background-color: #4facfe;
  color: #fff;
  border-radius: 15rpx;
  font-size: 30rpx;
}

.add-contact-btn .icon-add {
  margin-right: 10rpx;
  font-size: 32rpx;
}

/* 联系人列表 */
.contact-list {
  padding: 0 20rpx;
}

.contact-item {
  display: flex;
  align-items: center;
  padding: 25rpx 0;
  border-bottom: 1rpx solid #eee;
}

.avatar {
  width: 90rpx;
  height: 90rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}

.contact-info {
  flex: 1;
}

.contact-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.contact-signature {
  font-size: 26rpx;
  color: #999;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.contact-status {
  padding: 0 20rpx;
}

.mutual-follow {
  font-size: 24rpx;
  color: #4facfe;
  padding: 8rpx 20rpx;
  border: 1rpx solid #4facfe;
  border-radius: 15rpx;
}

.following {
  font-size: 24rpx;
  color: #999;
  padding: 8rpx 20rpx;
  border: 1rpx solid #ddd;
  border-radius: 15rpx;
}

.not-follow {
  font-size: 24rpx;
  color: #4facfe;
  padding: 8rpx 20rpx;
  border: 1rpx solid #4facfe;
  border-radius: 15rpx;
}

.no-contacts {
  text-align: center;
  padding: 60rpx 0;
  color: #999;
  font-size: 28rpx;
}

/* 对话框样式 */
.dialog-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 1000;
}

.dialog {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 80%;
  background-color: #fff;
  border-radius: 20rpx;
  z-index: 1001;
  overflow: hidden;
}

.dialog-title {
  padding: 30rpx;
  text-align: center;
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
  border-bottom: 1rpx solid #eee;
}

.dialog-content {
  padding: 30rpx;
}

.input-group {
  margin-bottom: 30rpx;
}

.input-group .label {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.input-group input {
  width: 100%;
  height: 80rpx;
  border: 1rpx solid #ddd;
  border-radius: 10rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
}

.dialog-buttons {
  display: flex;
  border-top: 1rpx solid #eee;
}

.cancel-btn, .confirm-btn {
  flex: 1;
  height: 90rpx;
  line-height: 90rpx;
  text-align: center;
  font-size: 32rpx;
  padding: 0;
  margin: 0;
}

.cancel-btn {
  color: #666;
  background-color: #f5f5f5;
}

.confirm-btn {
  color: #fff;
  background-color: #4facfe;
}

/* 图标样式 */
.icon-search::before {
  content: "🔍";
}

.icon-clear::before {
  content: "✕";
}

.icon-add::before {
  content: "➕";
}