/* profile.wxss */
.container {
  background-color: #f8f8f8;
  padding-bottom: 100rpx;
}

/* 用户信息区域 */
.user-info-section {
  background-color: #fff;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.user-header {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  margin-right: 30rpx;
}

.user-details {
  flex: 1;
}

.user-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.user-id {
  font-size: 28rpx;
  color: #999;
}

.edit-btn {
  width: 140rpx;
  height: 60rpx;
  line-height: 60rpx;
  background-color: #f5f5f5;
  color: #666;
  font-size: 28rpx;
  border-radius: 30rpx;
  padding: 0;
}

.user-stats {
  display: flex;
  justify-content: space-around;
  padding-top: 30rpx;
  border-top: 1rpx solid #eee;
}

.stat-item {
  text-align: center;
}

.stat-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.stat-label {
  font-size: 28rpx;
  color: #666;
}

/* 功能菜单 */
.menu-section {
  background-color: #fff;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.menu-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 30rpx;
}

.menu-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20rpx;
}

.menu-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.menu-icon {
  width: 100rpx;
  height: 100rpx;
  border-radius: 20rpx;
  margin-bottom: 15rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 50rpx;
}

.travel-guide-icon {
  background-color: #e3f2fd;
  color: #2196f3;
}

.destination-icon {
  background-color: #e8f5e9;
  color: #4caf50;
}

.weather-icon {
  background-color: #fff3e0;
  color: #ff9800;
}

.map-icon {
  background-color: #f3e5f5;
  color: #9c27b0;
}

.menu-label {
  font-size: 28rpx;
  color: #666;
}

/* 设置菜单 */
.setting-section {
  background-color: #fff;
  margin-bottom: 30rpx;
}

.setting-item {
  display: flex;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #eee;
}

.setting-item:last-child {
  border-bottom: none;
}

.setting-icon {
  width: 50rpx;
  height: 50rpx;
  border-radius: 10rpx;
  margin-right: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
}

.settings-icon {
  background-color: #f5f5f5;
  color: #666;
}

.about-icon {
  background-color: #f5f5f5;
  color: #666;
}

.feedback-icon {
  background-color: #f5f5f5;
  color: #666;
}

.cache-icon {
  background-color: #f5f5f5;
  color: #666;
}

.setting-label {
  flex: 1;
  font-size: 32rpx;
  color: #333;
}

.setting-arrow {
  width: 30rpx;
  height: 30rpx;
  border-top: 2rpx solid #999;
  border-right: 2rpx solid #999;
  transform: rotate(45deg);
}

.cache-size {
  font-size: 28rpx;
  color: #999;
  margin-right: 20rpx;
}

/* 退出登录按钮 */
.logout-btn {
  margin: 0 30rpx;
  height: 90rpx;
  line-height: 90rpx;
  background-color: #fff;
  color: #ff4d4f;
  font-size: 32rpx;
  border-radius: 10rpx;
}

/* 图标样式 */
.travel-guide-icon::before {
  content: "📖";
}

.destination-icon::before {
  content: "📍";
}

.weather-icon::before {
  content: "☀️";
}

.map-icon::before {
  content: "🗺️";
}

.settings-icon::before {
  content: "⚙️";
}

.about-icon::before {
  content: "ℹ️";
}

.feedback-icon::before {
  content: "💬";
}

.cache-icon::before {
  content: "🗑️";
}