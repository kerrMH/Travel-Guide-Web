/* detail.wxss */
.container {
  background-color: #f8f8f8;
  padding-bottom: 20rpx;
}

/* 内容主体 */
.content-main {
  background-color: #fff;
  margin-bottom: 20rpx;
}

/* 媒体展示区域 */
.media-container {
  width: 100%;
  background-color: #000;
}

.content-image {
  width: 100%;
  max-height: 600rpx;
}

.content-video {
  width: 100%;
  height: 600rpx;
}

/* 内容信息 */
.content-info {
  padding: 30rpx;
}

.content-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.content-description {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 30rpx;
}

/* 作者信息 */
.author-info {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-top: 1rpx solid #eee;
  border-bottom: 1rpx solid #eee;
  margin-bottom: 30rpx;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}

.author-details {
  flex: 1;
}

.author-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.publish-time {
  font-size: 24rpx;
  color: #999;
}

.follow-btn {
  width: 140rpx;
  height: 60rpx;
  line-height: 60rpx;
  background-color: #4facfe;
  color: #fff;
  font-size: 28rpx;
  border-radius: 30rpx;
  padding: 0;
}

.following-btn {
  width: 140rpx;
  height: 60rpx;
  line-height: 60rpx;
  background-color: #f5f5f5;
  color: #999;
  font-size: 28rpx;
  border-radius: 30rpx;
  padding: 0;
}

/* 互动按钮 */
.action-buttons {
  display: flex;
  justify-content: space-around;
  padding: 20rpx 0;
}

.action-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #999;
}

.action-btn.active {
  color: #4facfe;
}

.action-btn .iconfont {
  font-size: 40rpx;
  margin-bottom: 10rpx;
}

.action-btn text:last-child {
  font-size: 24rpx;
}

/* 评论区 */
.comment-section {
  background-color: #fff;
  padding: 30rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 30rpx;
}

/* 评论输入框 */
.comment-input-container {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
  padding: 15rpx;
  background-color: #f5f5f5;
  border-radius: 30rpx;
}

.comment-input {
  flex: 1;
  height: 60rpx;
  font-size: 28rpx;
  color: #333;
  padding: 0 20rpx;
}

.send-btn {
  width: 100rpx;
  height: 60rpx;
  line-height: 60rpx;
  background-color: #4facfe;
  color: #fff;
  font-size: 28rpx;
  border-radius: 30rpx;
  padding: 0;
}

.send-btn[disabled] {
  background-color: #ccc;
}

/* 评论列表 */
.comment-list {
  max-height: 800rpx;
  overflow-y: auto;
}

.comment-item {
  display: flex;
  margin-bottom: 30rpx;
}

.comment-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}

.comment-content {
  flex: 1;
}

.comment-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.comment-author {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.comment-time {
  font-size: 24rpx;
  color: #999;
}

.comment-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
  margin-bottom: 15rpx;
}

.comment-actions {
  display: flex;
  align-items: center;
}

.comment-like {
  display: flex;
  align-items: center;
  margin-right: 30rpx;
  color: #999;
}

.comment-like.active {
  color: #4facfe;
}

.comment-like .iconfont {
  font-size: 24rpx;
  margin-right: 5rpx;
}

.comment-like text {
  font-size: 24rpx;
}

.comment-reply {
  color: #999;
  font-size: 24rpx;
}

.no-comments {
  text-align: center;
  padding: 60rpx 0;
  color: #999;
  font-size: 28rpx;
}

/* 图标样式 */
.icon-heart::before {
  content: "❤️";
}

.icon-collect::before {
  content: "⭐";
}

.icon-share::before {
  content: "📤";
}