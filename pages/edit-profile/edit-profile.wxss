.edit-profile-container {
  background-color: #f5f5f5;
  min-height: 100vh;
}

.profile-header {
  background-color: #fff;
  padding: 20rpx 30rpx;
  border-bottom: 1rpx solid #e0e0e0;
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  height: 90rpx;
}

.header-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  text-align: center;
  flex: 1;
}

.profile-form {
  padding-top: 110rpx;
  padding-bottom: 40rpx;
  background-color: #fff;
}

.form-item {
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.form-item:last-child {
  border-bottom: none;
}

.item-label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 20rpx;
}

.item-input {
  font-size: 32rpx;
  color: #333;
  width: 100%;
  padding: 10rpx 0;
}

.item-textarea {
  font-size: 32rpx;
  color: #333;
  width: 100%;
  padding: 10rpx 0;
  min-height: 120rpx;
  line-height: 44rpx;
}

.text-count {
  font-size: 24rpx;
  color: #999;
  text-align: right;
  display: block;
  margin-top: 10rpx;
}

/* 头像样式 */
.avatar-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.avatar-container {
  position: relative;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
}

.avatar-upload {
  position: absolute;
  bottom: 0;
  right: 0;
  background-color: #1aad19;
  color: #fff;
  width: 40rpx;
  height: 40rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}

/* 性别选择器 */
.gender-selector {
  display: flex;
  gap: 30rpx;
}

.gender-option {
  flex: 1;
  padding: 20rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 8rpx;
  text-align: center;
}

.gender-option.selected {
  border-color: #1aad19;
  background-color: #f0f9f0;
}

.gender-icon {
  font-size: 40rpx;
  display: block;
  margin-bottom: 10rpx;
}

.gender-text {
  font-size: 28rpx;
  color: #333;
}

/* 日期和位置选择器 */
.date-picker,
.location-picker {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10rpx 0;
}

.date-text,
.location-text {
  font-size: 32rpx;
  color: #999;
}

.date-arrow,
.location-arrow {
  font-size: 36rpx;
  color: #ccc;
}

/* 兴趣爱好标签 */
.hobby-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.hobby-tag {
  padding: 15rpx 30rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 20rpx;
  font-size: 28rpx;
  color: #666;
}

.hobby-tag.selected {
  border-color: #1aad19;
  background-color: #f0f9f0;
  color: #1aad19;
}

/* 保存按钮 */
.save-container {
  padding: 30rpx;
  background-color: #f5f5f5;
}

.save-btn {
  background-color: #1aad19;
  color: #fff;
  font-size: 32rpx;
  border-radius: 8rpx;
  width: 100%;
  height: 90rpx;
  line-height: 90rpx;
}

.save-btn:active {
  background-color: #179b16;
}