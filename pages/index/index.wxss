/* index.wxss */
.container {
  padding-bottom: 100rpx;
  background-color: #f8f8f8;
}

/* 搜索栏样式 */
.search-bar {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background-color: #fff;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  position: sticky;
  top: 0;
  z-index: 100;
}

.search-input {
  flex: 1;
  display: flex;
  align-items: center;
  background-color: #f5f5f5;
  border-radius: 30rpx;
  padding: 0 20rpx;
  height: 70rpx;
}

.search-input .icon-search {
  color: #999;
  margin-right: 10rpx;
}

.search-input input {
  flex: 1;
  height: 100%;
  font-size: 28rpx;
  color: #333;
}

.search-input .icon-clear {
  color: #999;
  padding: 10rpx;
}

.search-btn {
  margin-left: 20rpx;
  font-size: 28rpx;
  color: #4facfe;
  padding: 0 20rpx;
}

/* 内容区域 */
.content-container {
  padding: 20rpx;
}

/* 瀑布流布局 */
.waterfall-container {
  display: flex;
  justify-content: space-between;
}

.waterfall-column {
  width: 48.5%;
}

/* 瀑布流卡片 */
.waterfall-item {
  background-color: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  transition: transform 0.3s, box-shadow 0.3s;
}

.waterfall-item:active {
  transform: scale(0.98);
  box-shadow: 0 1rpx 5rpx rgba(0, 0, 0, 0.1);
}

.item-image {
  width: 100%;
  aspect-ratio: 3/4;
  background-color: #f0f0f0;
}

.item-info {
  padding: 20rpx;
}

.item-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.item-desc {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 15rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  line-height: 1.4;
}

.item-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.author-info {
  display: flex;
  align-items: center;
}

.avatar {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  margin-right: 10rpx;
}

.author-name {
  font-size: 24rpx;
  color: #999;
}

.item-stats {
  display: flex;
  align-items: center;
}

.item-stats .iconfont {
  font-size: 24rpx;
  color: #999;
  margin-left: 20rpx;
}

/* 加载更多 */
.load-more {
  text-align: center;
  padding: 30rpx 0;
  color: #999;
  font-size: 28rpx;
}

/* 图标样式 */
.icon-search::before {
  content: "🔍";
}

.icon-clear::before {
  content: "✕";
}

.icon-heart::before {
  content: "❤️";
}

.icon-comment::before {
  content: "💬";
}

/* 轮播图样式 */
.item-swiper {
  width: 100%;
  height: 350rpx;
  border-radius: 20rpx;
  overflow: hidden;
  position: relative;
}

.item-swiper .item-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* 轮播图指示器样式 */
wx-swiper .wx-swiper-dot {
  width: 12rpx;
  height: 12rpx;
  margin: 0 6rpx;
  background-color: rgba(255, 255, 255, 0.6);
  border-radius: 6rpx;
}

wx-swiper .wx-swiper-dot-active {
  background-color: #fff;
  width: 24rpx;
}