<!-- message.wxml -->
<view class="container">
  <!-- 消息分类标签 -->
  <view class="message-tabs">
    <view class="tab {{activeTab === 'all' ? 'active' : ''}}" bindtap="switchTab" data-tab="all">全部</view>
    <view class="tab {{activeTab === 'comment' ? 'active' : ''}}" bindtap="switchTab" data-tab="comment">评论</view>
    <view class="tab {{activeTab === 'like' ? 'active' : ''}}" bindtap="switchTab" data-tab="like">点赞</view>
    <view class="tab {{activeTab === 'system' ? 'active' : ''}}" bindtap="switchTab" data-tab="system">系统</view>
  </view>

  <!-- 消息列表 -->
  <view class="message-list">
    <block wx:if="{{filteredMessages.length > 0}}">
      <view wx:for="{{filteredMessages}}" wx:key="id" class="message-item {{item.isRead ? 'read' : 'unread'}}" bindtap="viewMessageDetail" data-id="{{item.id}}" data-type="{{item.type}}" data-related-id="{{item.relatedId}}">
        <view class="message-avatar">
          <image class="avatar" src="{{item.avatar}}" mode="aspectFill"></image>
          <view wx:if="{{!item.isRead}}" class="unread-dot"></view>
        </view>
        <view class="message-content">
          <view class="message-header">
            <view class="message-title">{{item.title}}</view>
            <view class="message-time">{{item.createTime}}</view>
          </view>
          <view class="message-text">{{item.content}}</view>
        </view>
      </view>
    </block>
    <view wx:else class="no-messages">
      <text>暂无消息</text>
    </view>
  </view>

  <!-- 一键已读按钮 -->
  <view class="read-all-btn" wx:if="{{unreadCount > 0}}" bindtap="markAllAsRead">
    <text>全部已读 ({{unreadCount}})</text>
  </view>
</view>