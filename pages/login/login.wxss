/* login.wxss */
.container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 60rpx 40rpx;
  box-sizing: border-box;
  background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
}

.logo-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 100rpx;
}

.logo {
  width: 200rpx;
  height: 200rpx;
  border-radius: 40rpx;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.2);
}

.app-name {
  font-size: 60rpx;
  font-weight: bold;
  color: #fff;
  margin-top: 40rpx;
  text-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.slogan {
  font-size: 30rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 20rpx;
}

.form-container {
  width: 100%;
  background: #fff;
  border-radius: 30rpx;
  padding: 40rpx;
  box-shadow: 0 20rpx 40rpx rgba(0, 0, 0, 0.1);
  margin: 60rpx 0;
}

.input-group {
  display: flex;
  align-items: center;
  border-bottom: 2rpx solid #eee;
  padding: 20rpx 0;
  margin-bottom: 30rpx;
}

.input-group .iconfont {
  font-size: 36rpx;
  color: #4facfe;
  margin-right: 20rpx;
}

.input-group input {
  flex: 1;
  font-size: 32rpx;
  color: #333;
}

.login-btn {
  width: 100%;
  height: 90rpx;
  line-height: 90rpx;
  background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
  color: #fff;
  font-size: 36rpx;
  border-radius: 45rpx;
  margin-top: 40rpx;
  box-shadow: 0 10rpx 30rpx rgba(79, 172, 254, 0.4);
}

.login-btn:active {
  opacity: 0.8;
  transform: scale(0.98);
}

.tips {
  text-align: center;
  margin-top: 30rpx;
  font-size: 28rpx;
  color: #999;
}

.footer {
  text-align: center;
  color: rgba(255, 255, 255, 0.6);
  font-size: 24rpx;
  margin-bottom: 40rpx;
}

/* 图标样式 */
.icon-user::before {
  content: "👤";
}

.icon-lock::before {
  content: "🔒";
}